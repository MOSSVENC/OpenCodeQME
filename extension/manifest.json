{
  "manifest_version": 3,
  "name": "68HUB Material",
  "version": "0.1.0",
  "description": "OpenCode Go single-user usage dashboard with full local history.",
  "permissions": ["alarms", "cookies", "storage"],
  "host_permissions": ["https://opencode.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "68HUB Material",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
